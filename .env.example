# ============ Application ============
LOGIN_ENABLED=false
APP_NAME=RalphLAB
APP_ENV=development
APP_DEBUG=true

# ============ Backend API ============
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-this-in-production-please-use-long-random-string
AUTH_SECRET=use-the-same-long-random-secret-as-nextauth-secret
CORS_ORIGINS=*

# ============ Database (PostgreSQL) ============
POSTGRES_USER=ralphguard
POSTGRES_PASSWORD=ralphguard_dev
POSTGRES_DB=ralphguard
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ralphguard:ralphguard_dev@postgres:5432/ralphguard

# ============ Redis ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
QUEUE_STREAM_NAME=ralphguard:jobs
ASSESSMENT_EXECUTION_MODE=disabled

# ============ Frontend ============
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=RalphGuard
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=use-the-same-long-random-secret-as-auth-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============ Scientific Worker ============
WORKER_CONCURRENCY=2
MODELS_DIR=/app/models
SCIENTIFIC_RUNTIME_DIR=/scientific

# ============ AI chat ============
# Groq is the primary provider. OpenAI is used if Groq is unavailable or unset.
# Keep both keys in the backend environment or this private .env file.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
